CompileFlags:
  # Point clangd at the cross-compile target and include roots.
  # Proper flags come from compile_commands.json generated by CMake.
  # Until then, these keep IDE diagnostics meaningful.
  Add:
    - --target=aarch64-none-elf
    - -ffreestanding
    - -fno-exceptions
    - -fno-rtti
    - -std=c++23
    - -Ikernel/include
    - -Ilib/include
    - -Iboot/include
    - -Iuserland/lib/include
