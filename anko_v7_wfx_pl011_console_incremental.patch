@@ -957,11 +957,11 @@
 
         if (ec == kEcWfx) {
             /*
-             * WFI/WFE are normal guest idle instructions, not diagnostic
-             * exits.  HCR_EL2.TWI/TWE are normally left clear now, so this
-             * path is only a defensive fallback for guests that still trap
-             * WFx.  Treat the instruction as complete and keep running within
-             * the caller's exit budget instead of flooding the host console.
+             * WFI/WFE are normal guest idle instructions.  We intentionally
+             * trap them instead of allowing the physical CPU to sleep because
+             * Anko must keep ownership of virtual timer/IRQ scheduling.
+             * Complete the instruction, account for it, and continue without
+             * printing per-idle-cycle diagnostics.
              */
             vcpu->el2.pc += 4;
             metric_inc(VM_DEBUG_VCPU_WFX_EXITS);
