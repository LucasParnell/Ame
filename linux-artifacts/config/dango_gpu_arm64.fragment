# Dango GPU appliance guest profile (Phase E).
#
# Applied *in addition to* dango_hello_arm64.fragment so the minimal bring-up
# profile stays untouched and boot regressions stay bisectable. It adds exactly
# what the virtio-gpu appliance needs and nothing else -- see
# docs/LINUX_APPLIANCE_MINIMAL.md and scripts/linux/check-minimal-config.py.
#
# Deliberately left off, with reasons (also enforced by the checker deny-list):
# - CONFIG_PCI_MSI / CONFIG_PCI_MSI_IRQ_DOMAIN / ITS: the synthetic host bridge
#   exposes a legacy INTx interrupt-map to the vGIC, so virtio-pci uses INTx,
#   delivered through the Phase D level-route machinery. MSI arrives with the
#   physical amdgpu profile, which needs it for real.
# - CONFIG_VIRTIO_IOMMU: the host SMMU translates IOVA == guest physical
#   address; the guest uses plain dma-direct and needs no IOMMU of its own.
# - CONFIG_DRM_FBDEV_EMULATION: the KMS path drives DRM/KMS directly; a legacy
#   fbdev console is not part of any flow.
# - CONFIG_VIRTIO_DMA_SHARED_BUFFER: zero-copy/dma-buf import is Phase M.

# --- PCI host bridge (generic ECAM; Ame serves a filtered config view) -------
CONFIG_PCI=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_DOMAINS=y
CONFIG_PCI_DOMAINS_GENERIC=y
CONFIG_PCIEPORTBUS=n

# --- virtio core + PCI transport --------------------------------------------
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# --- DRM + virtio-gpu (KMS) -------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y

# --- explicitly off (minimality) --------------------------------------------
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_VIRTIO_DMA_SHARED_BUFFER=n
CONFIG_VIRTIO_IOMMU=n

# --- platform/driver surface the appliance does not use (spec §19) -----------
# The guest runs one assigned virtio function on QEMU virt; every other arm64
# platform, bus and DRM driver is dead weight that slows boot and widens the
# surface.  Symbols absent on arm64 are ignored by kconfig.
CONFIG_ACPI=n
CONFIG_XEN=n
CONFIG_KVM=n
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
CONFIG_USB_SUPPORT=n
CONFIG_TYPEC=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_THERMAL=n
CONFIG_WATCHDOG=n
CONFIG_HWMON=n
CONFIG_RTC_CLASS=n
CONFIG_PWM=n
CONFIG_RESET_CONTROLLER=n
CONFIG_NVMEM=n
CONFIG_PHYLIB=n
CONFIG_POWER_SUPPLY=n
CONFIG_DRM_MSM=n
CONFIG_DRM_TEGRA=n
CONFIG_DRM_PANFROST=n
CONFIG_DRM_LIMA=n
CONFIG_DRM_ROCKCHIP=n
CONFIG_DRM_SUN4I=n
CONFIG_DRM_V3D=n
CONFIG_DRM_VC4=n
CONFIG_DRM_ETNAVIV=n
CONFIG_FB=n
CONFIG_LOGO=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMDGPU=n
CONFIG_IIO=n
CONFIG_CORESIGHT=n
