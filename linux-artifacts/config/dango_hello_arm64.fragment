CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_MMU=y

CONFIG_EXPERT=y
CONFIG_EMBEDDED=y

CONFIG_OF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y

CONFIG_TTY=y
CONFIG_VT=n

CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

CONFIG_MODULES=n
CONFIG_BLOCK=n
CONFIG_NET=n
CONFIG_PCI=n
CONFIG_USB=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_INPUT=n
CONFIG_WIRELESS=n
CONFIG_BT=n

# The autogroup scheduler `select`s CGROUPS, so it must be off for
# CONFIG_CGROUPS=n to take effect (verified empirically). MC/SMT and cpufreq
# are desktop-oriented and have no role in an appliance.
CONFIG_SCHED_AUTOGROUP=n
CONFIG_SCHED_MC=n
CONFIG_SCHED_SMT=n
CONFIG_CPU_FREQ=n

CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_AUDIT=n
CONFIG_SECURITY=n
CONFIG_BPF_SYSCALL=n
CONFIG_PERF_EVENTS=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_SWAP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n

CONFIG_ARM_ARCH_TIMER=y
CONFIG_HYPERVISOR_GUEST=y

# Keep the first Dango Linux bring-up as single-core and non-idle where possible.
# NOTE: on arm64 `config SMP` is `def_bool y` (architecture-forced), so the
# line below is retained for documentation only and has no effect. CPU_IDLE
# likewise resists =n in the current baseline (see docs/LINUX_APPLIANCE_MINIMAL.md).
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
CONFIG_CPU_IDLE=n

# The hello guest has only the synthetic OF-described GIC/timer/UART. Physical
# board support otherwise pulls thousands of unrelated clocks, power and bus
# drivers back in from arm64 defconfig, despite BLOCK/NET/USB being disabled.
CONFIG_ACPI=n
CONFIG_XEN=n
CONFIG_KVM=n
CONFIG_COMPAT=n
CONFIG_MTD=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_USB_SUPPORT=n
CONFIG_TYPEC=n
CONFIG_DMADEVICES=n
CONFIG_THERMAL=n
CONFIG_WATCHDOG=n
CONFIG_HWMON=n
CONFIG_RTC_CLASS=n
CONFIG_PWM=n
CONFIG_NVMEM=n
CONFIG_POWER_SUPPLY=n
CONFIG_IIO=n
CONFIG_CORESIGHT=n
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_ASPEED=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
