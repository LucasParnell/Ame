CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_MMU=y

CONFIG_EXPERT=y
CONFIG_EMBEDDED=y

CONFIG_OF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y

CONFIG_TTY=y
CONFIG_VT=n

CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

CONFIG_MODULES=n
CONFIG_BLOCK=n
CONFIG_NET=n
CONFIG_PCI=n
CONFIG_USB=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_INPUT=n
CONFIG_WIRELESS=n
CONFIG_BT=n

CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_AUDIT=n
CONFIG_SECURITY=n
CONFIG_BPF_SYSCALL=n
CONFIG_PERF_EVENTS=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_SWAP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n

CONFIG_ARM_ARCH_TIMER=y
CONFIG_HYPERVISOR_GUEST=y

# Keep the first Dango Linux bring-up as single-core and non-idle where possible.
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
CONFIG_CPU_IDLE=n
