# ANE-LX1 Mali-T830 driver appliance. Apply to allnoconfig, not defconfig.
# Panfrost contains the Midgard MMU; no PCI or external IOMMU driver is needed
# inside the guest. Ame must still isolate physical DMA before assignment.
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_MMU=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# The appliance exposes one vCPU on Cortex-A53 (NR_CPUS has an arm64
# minimum of two). Avoid the default five-level, 52-bit/LPA2 page tables.
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_ARM64_LPA2=n
CONFIG_NR_CPUS=2
CONFIG_LOG_BUF_SHIFT=14
CONFIG_SMP=y
CONFIG_PREEMPT_NONE=y
CONFIG_LOCALVERSION="-dango-panfrost"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_OF=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_HZ_100=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BASE_SMALL=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
CONFIG_COREDUMP=n
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FUTEX=y
CONFIG_PM=y
CONFIG_COMMON_CLK=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_DRM=y
CONFIG_DRM_PANFROST=y
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_DRM_PANIC=n
CONFIG_MODULES=n
CONFIG_BLOCK=n
CONFIG_NET=n
CONFIG_NAMESPACES=n
CONFIG_PCI=n
CONFIG_USB_SUPPORT=n
CONFIG_INPUT=n
CONFIG_SOUND=n
CONFIG_VT=n
# EXPERT selects DEBUG_KERNEL; keep the actual debug facilities off.
CONFIG_DEBUG_MISC=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_KALLSYMS=n
CONFIG_IKCONFIG=n
CONFIG_PERF_EVENTS=n
CONFIG_FTRACE=n
CONFIG_CPU_IDLE=n
CONFIG_CPU_FREQ=n
CONFIG_SUSPEND=n
CONFIG_SWAP=n
CONFIG_SECURITY=n
CONFIG_SECCOMP=n
CONFIG_STACKPROTECTOR=n
CONFIG_RANDOMIZE_BASE=n
