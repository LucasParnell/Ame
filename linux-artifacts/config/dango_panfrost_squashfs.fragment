# Optional read-only runtime storage; the guest remains 128 MiB.
# Merge with dango_panfrost_arm64.fragment, never the generic appliance policy.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=1
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_DECOMP_SINGLE=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=1
CONFIG_SQUASHFS_EMBEDDED=y
CONFIG_SQUASHFS_ZLIB=n
CONFIG_SQUASHFS_LZ4=n
CONFIG_SQUASHFS_LZO=n
CONFIG_SQUASHFS_ZSTD=n
CONFIG_SQUASHFS_XATTR=n
