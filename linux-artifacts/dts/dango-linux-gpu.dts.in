/dts-v1/;

// Dango GPU appliance guest hardware description (Phase E).
//
// Same minimal platform as dango-linux-minimal.dts.in, plus:
//  - a generic PCI host bridge whose ECAM is the *synthetic* config view Dango
//    exposes (only the assigned virtio-gpu-pci function is present);
//  - the assigned function's MMIO window (appliance IPAs, backed by the host
//    BAR through a stage-2 Device mapping);
//  - a legacy INTx interrupt-map into the vGIC (MSI is a later, amdgpu-driven
//    addition);
//  - the Dango paravirtual channel reserved-memory region (Phase G).
//
// The outer SMMUv3 is Ame-owned and invisible here: Linux uses plain
// dma-direct with IOVA == guest physical address.

/ {
    compatible = "midix,dango-linux-gpu", "linux,dummy-virt";
    #address-cells = <2>;
    #size-cells = <2>;
    interrupt-parent = <&intc>;

    chosen {
        stdout-path = "serial0:115200n8";
        bootargs = "@BOOTARGS@";
        linux,initrd-start = <@INITRD_START_HI@ @INITRD_START_LO@>;
        linux,initrd-end   = <@INITRD_END_HI@ @INITRD_END_LO@>;
    };

    memory@40000000 {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x08000000>; // 128 MiB (see memory_size in the manifest)
    };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        // Host<->guest Dango channel rings (mapped by the VM loader, pinned).
        dango_channel: dango-channel@48000000 {
            reg = <0x0 0x48000000 0x0 0x20000>;
            no-map;
        };
    };

    channel@48000000 {
        compatible = "ame,dango-channel-v1";
        reg = <0x0 0x48000000 0x0 0x20000>;
        memory-region = <&dango_channel>;
        interrupts = <0 16 1>; // virtual SPI 48, edge triggered
    };

    psci {
        compatible = "arm,psci-0.2";
        method = "hvc";
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;

        cpu@0 {
            device_type = "cpu";
            compatible = "arm,arm-v8";
            reg = <0>;
            enable-method = "psci";
        };
    };

    intc: interrupt-controller@8000000 {
        compatible = "arm,cortex-a15-gic";
        #interrupt-cells = <3>;
        #address-cells = <0>;
        interrupt-controller;
        reg = <0x0 0x08000000 0x0 0x10000>,
              <0x0 0x08010000 0x0 0x10000>;
    };

    timer {
        compatible = "arm,armv8-timer";
        interrupts = <1 13 0xf08>,
                     <1 14 0xf08>,
                     <1 11 0xf08>,
                     <1 10 0xf08>;
    };

    uart0: serial@9000000 {
        compatible = "arm,sbsa-uart";
        reg = <0x0 0x09000000 0x0 0x1000>;
        interrupts = <0 1 4>;
        current-speed = <115200>;
        status = "okay";
    };

    // Synthetic PCIe root complex. ECAM at 0x3f000000 holds only the assigned
    // function; Dango fills and mediates it. The MMIO window is where the
    // function's BARs appear to the guest (appliance IPAs).
    pcie: pci@3f000000 {
        compatible = "pci-host-ecam-generic";
        device_type = "pci";
        #address-cells = <3>;
        #size-cells = <2>;
        #interrupt-cells = <1>;
        reg = <0x0 0x3f000000 0x0 0x00100000>;      // one bus, 1 MiB ECAM
        bus-range = <0x00 0x00>;
        ranges = <0x02000000 0x0 0x50000000 0x0 0x50000000 0x0 0x10000000>; // MMIO32, outside RAM
        dma-coherent;
        interrupt-map-mask = <0xf800 0x0 0x0 0x7>;
        interrupt-map = <0x0800 0x0 0x0 0x1 &intc 0x0 0x0c 0x4>,
                        <0x0800 0x0 0x0 0x2 &intc 0x0 0x0d 0x4>,
                        <0x0800 0x0 0x0 0x3 &intc 0x0 0x0e 0x4>,
                        <0x0800 0x0 0x0 0x4 &intc 0x0 0x0f 0x4>;
    };

    aliases {
        serial0 = &uart0;
    };
};
