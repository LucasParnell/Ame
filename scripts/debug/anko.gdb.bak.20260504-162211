end

break syscall_return_eret
commands
  silent
  maybe_print_eret_syscall
  continue
end

break irq_return_eret
commands
  silent
  maybe_print_eret_irq
  continue
end

break syscall_fault
commands
  silent
  set $ec = ($x0 >> 26) & 0x3f

  if $ec == 0x3c
    set $tf = (unsigned long *)$x2
    printf "\n--- ignoring EL0 BRK/trap at "
    p/a $tf[31]
    continue
  end

  printf "\n--- EL0 real fault ---\n"
  dump_fault
  printf "\nStopped. Use 'continue' to resume.\n"
end

break kernel_sync_fault
commands
  silent
  printf "\n--- EL1 kernel fault ---\n"
  dump_fault
  printf "\nStopped. Use 'continue' to resume.\n"
end

rbreak ^panic

continue
