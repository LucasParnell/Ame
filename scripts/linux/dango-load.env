# Single source of truth for the Dango guest static load addresses (guest
# physical, as written into the DTB and the artifact manifest).
#
# Sourced by scripts/linux/{build-dtb,build-manifest,build-min-linux}.sh so the
# device tree, the manifest and the minimal-image builder cannot drift apart.
DANGO_INITRAMFS_LOAD=0x46000000
DANGO_DTB_LOAD=0x47000000
