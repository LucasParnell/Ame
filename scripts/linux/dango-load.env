# Dango guest static load addresses (guest physical), as written into the DTB
# and the artifact manifest. They are layout facts, so they come from the single
# layout header rather than being restated here.
#
# Sourced by scripts/linux/{build-dtb,build-manifest,build-min-linux}.sh.
AME="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
LAYOUT_HEADER="${AME}/shared/include/midix/abi/dango_guest_layout.h"
LAYOUT="${DANGO_LINUX_GUEST:-${DANGO_GUEST_LAYOUT:-minimal}}"

layout_load() {
    python3 "${AME}/scripts/linux/layout_macro.py" \
        "${LAYOUT_HEADER}" "${LAYOUT}" "$1" | sed -n "s/^$1=//p"
}

DANGO_INITRAMFS_LOAD="$(printf '0x%x' "$(layout_load DANGO_INITRAMFS_LOAD)")"
DANGO_DTB_LOAD="$(printf '0x%x' "$(layout_load DANGO_DTB_LOAD)")"
