#!/usr/bin/env python3
import math
import os
import sys


def fmul(bits, n, d):
    return ((1 << bits) * n + d - 1) // d


def fadj(bits, n, d):
    d = d // math.gcd(n, d)
    return ((1 << bits) * (d - 1)) // d


def fmuls(bits, n, d):
    shift = 0
    while True:
        if fmul(shift, n, d) >= (1 << (bits - 1)):
            return shift
        shift += 1


def emit_timeconst(hz):
    def hx(value):
        return format(value, "X")

    out = []
    out.append("/* Automatically generated by kernel/time/timeconst.bc */")
    out.append(f"/* Time conversion constants for HZ == {hz} */")
    out.append("")
    out.append("#ifndef KERNEL_TIMECONST_H")
    out.append("#define KERNEL_TIMECONST_H")
    out.append("")
    out.append("#include <linux/param.h>")
    out.append("#include <linux/types.h>")
    out.append("")
    out.append(f"#if HZ != {hz}")
    out.append('#error "include/generated/timeconst.h has the wrong HZ value!"')
    out.append("#endif")
    out.append("")
    if hz < 2:
        out.append("#error Totally bogus HZ value!")
    else:
        s = fmuls(32, 1000, hz)
        out.append(f"#define HZ_TO_MSEC_MUL32\tU64_C(0x{hx(fmul(s, 1000, hz))})")
        out.append(f"#define HZ_TO_MSEC_ADJ32\tU64_C(0x{hx(fadj(s, 1000, hz))})")
        out.append(f"#define HZ_TO_MSEC_SHR32\t{s}")

        s = fmuls(32, hz, 1000)
        out.append(f"#define MSEC_TO_HZ_MUL32\tU64_C(0x{hx(fmul(s, hz, 1000))})")
        out.append(f"#define MSEC_TO_HZ_ADJ32\tU64_C(0x{hx(fadj(s, hz, 1000))})")
        out.append(f"#define MSEC_TO_HZ_SHR32\t{s}")

        cd = math.gcd(hz, 1000)
        out.append(f"#define HZ_TO_MSEC_NUM\t\t{1000 // cd}")
        out.append(f"#define HZ_TO_MSEC_DEN\t\t{hz // cd}")
        out.append(f"#define MSEC_TO_HZ_NUM\t\t{hz // cd}")
        out.append(f"#define MSEC_TO_HZ_DEN\t\t{1000 // cd}")
        out.append("")

        s = fmuls(32, 1000000, hz)
        out.append(f"#define HZ_TO_USEC_MUL32\tU64_C(0x{hx(fmul(s, 1000000, hz))})")
        out.append(f"#define HZ_TO_USEC_ADJ32\tU64_C(0x{hx(fadj(s, 1000000, hz))})")
        out.append(f"#define HZ_TO_USEC_SHR32\t{s}")

        s = fmuls(32, hz, 1000000)
        out.append(f"#define USEC_TO_HZ_MUL32\tU64_C(0x{hx(fmul(s, hz, 1000000))})")
        out.append(f"#define USEC_TO_HZ_ADJ32\tU64_C(0x{hx(fadj(s, hz, 1000000))})")
        out.append(f"#define USEC_TO_HZ_SHR32\t{s}")

        cd = math.gcd(hz, 1000000)
        out.append(f"#define HZ_TO_USEC_NUM\t\t{1000000 // cd}")
        out.append(f"#define HZ_TO_USEC_DEN\t\t{hz // cd}")
        out.append(f"#define USEC_TO_HZ_NUM\t\t{hz // cd}")
        out.append(f"#define USEC_TO_HZ_DEN\t\t{1000000 // cd}")

        cd = math.gcd(hz, 1000000000)
        out.append(f"#define HZ_TO_NSEC_NUM\t\t{1000000000 // cd}")
        out.append(f"#define HZ_TO_NSEC_DEN\t\t{hz // cd}")
        out.append(f"#define NSEC_TO_HZ_NUM\t\t{hz // cd}")
        out.append(f"#define NSEC_TO_HZ_DEN\t\t{1000000000 // cd}")
        out.append("")

    out.append("#endif /* KERNEL_TIMECONST_H */")
    print("\n".join(out))


def main():
    script = None
    for arg in sys.argv[1:]:
        if arg == "-q":
            continue
        script = arg
    if script and os.path.basename(script) == "timeconst.bc":
        data = sys.stdin.read().strip()
        emit_timeconst(int(data or "100"))
        return 0
    sys.stderr.write("minimal bc shim only supports kernel/time/timeconst.bc\n")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
