diff --git a/src/panfrost/vulkan/midgard/panvk_v5_blend.c b/src/panfrost/vulkan/midgard/panvk_v5_blend.c
new file mode 100644
index 0000000..efdda69
--- /dev/null
+++ b/src/panfrost/vulkan/midgard/panvk_v5_blend.c
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: MIT */
+#include "panvk_blend.h"
+#include "panvk_shader.h"
+#include "vk_graphics_state.h"
+#include "vk_format.h"
+VkResult panvk_v5_blend_emit_descs(struct panvk_device *dev,
+   const struct vk_dynamic_graphics_state *dyn,
+   const VkFormat *formats, uint8_t *samples,
+   const struct pan_shader_info *info, mali_ptr code,
+   struct mali_blend_packed *descs, struct panvk_blend_info *out)
+{
+   memset(out, 0, sizeof(*out));
+   for (unsigned i = 0; i < MAX2(dyn->cb.attachment_count, 1); i++) {
+      const struct vk_color_blend_attachment_state *att = &dyn->cb.attachments[i];
+      if (att->blend_enable || dyn->cb.logic_op_enable || dyn->ms.alpha_to_one_enable)
+         return VK_ERROR_FEATURE_NOT_PRESENT;
+      pan_pack(&descs[i], BLEND, cfg) {
+         cfg.enable = i < dyn->cb.attachment_count && formats[i] != VK_FORMAT_UNDEFINED &&
+                      (dyn->cb.color_write_enables & BITFIELD_BIT(i)) && att->write_mask;
+         cfg.srgb = cfg.enable && util_format_is_srgb(vk_format_to_pipe_format(formats[i]));
+         cfg.round_to_fb_precision = true;
+         cfg.equation.rgb.a = MALI_BLEND_OPERAND_A_SRC;
+         cfg.equation.rgb.b = MALI_BLEND_OPERAND_B_SRC;
+         cfg.equation.rgb.c = MALI_BLEND_OPERAND_C_ZERO;
+         cfg.equation.alpha = cfg.equation.rgb;
+         cfg.equation.color_mask = att->write_mask;
+      }
+   }
+   return VK_SUCCESS;
+}
diff --git a/src/panfrost/vulkan/midgard/panvk_v5_cmd_fb_preload.c b/src/panfrost/vulkan/midgard/panvk_v5_cmd_fb_preload.c
new file mode 100644
index 0000000..8669d39
--- /dev/null
+++ b/src/panfrost/vulkan/midgard/panvk_v5_cmd_fb_preload.c
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: MIT */
+#include "panvk_cmd_fb_preload.h"
+VkResult panvk_v5_cmd_fb_preload(struct panvk_cmd_buffer *cmdbuf)
+{
+   const struct pan_fb_info *fb = &cmdbuf->state.gfx.render.fb.info;
+   bool preload = fb->zs.preload.z || fb->zs.preload.s;
+   for (unsigned i = 0; i < fb->rt_count; i++)
+      preload |= fb->rts[i].preload;
+   if (preload) {
+      vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_FEATURE_NOT_PRESENT);
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+   return VK_SUCCESS;
+}
diff --git a/src/panfrost/vulkan/midgard/panvk_v5_meta_desc_copy.c b/src/panfrost/vulkan/midgard/panvk_v5_meta_desc_copy.c
new file mode 100644
index 0000000..b410671
--- /dev/null
+++ b/src/panfrost/vulkan/midgard/panvk_v5_meta_desc_copy.c
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: MIT */
+#include "panvk_cmd_alloc.h"
+#include "panvk_meta.h"
+#include "panvk_shader.h"
+VkResult panvk_v5_meta_get_copy_desc_job(struct panvk_cmd_buffer *cmd,
+   const struct panvk_shader *shader, const struct panvk_descriptor_state *state,
+   const struct panvk_shader_desc_state *dst, uint32_t attrib_offset,
+   struct panfrost_ptr *job)
+{
+   *job = (struct panfrost_ptr){0};
+   if (!shader) return VK_SUCCESS;
+   const uint32_t *map = panvk_priv_mem_host_addr(shader->desc_info.others.map);
+   unsigned map_offset = 0;
+   for (unsigned table = 0; table < PANVK_BIFROST_DESC_TABLE_COUNT; table++) {
+      unsigned count = shader->desc_info.others.count[table];
+      if (!count) continue;
+      if (table == PANVK_BIFROST_DESC_TABLE_IMG) {
+         vk_command_buffer_set_error(&cmd->vk, VK_ERROR_FEATURE_NOT_PRESENT);
+         return VK_ERROR_FEATURE_NOT_PRESENT;
+      }
+      unsigned size = table == PANVK_BIFROST_DESC_TABLE_UBO ||
+                      table == PANVK_BIFROST_DESC_TABLE_TEXTURE ? 8 : PANVK_DESCRIPTOR_SIZE;
+      for (unsigned i = 0; i < count; i++) {
+         uint32_t handle = map[map_offset + i];
+         unsigned set_idx = COPY_DESC_HANDLE_EXTRACT_TABLE(handle);
+         unsigned index = COPY_DESC_HANDLE_EXTRACT_INDEX(handle);
+         const struct panvk_descriptor_set *set = state->sets[set_idx];
+         void *output = dst->table_hosts[table] + i * size;
+         if (!set || index >= set->desc_count)
+            memset(output, 0, size);
+         else
+            memcpy(output, set->descs.host + index * PANVK_DESCRIPTOR_SIZE, size);
+      }
+      map_offset += count;
+   }
+   return VK_SUCCESS;
+}
