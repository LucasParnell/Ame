+VkResult
+panvk_v5_cmd_fb_preload(struct panvk_cmd_buffer *cmdbuf)
+{
+   struct pan_fb_info *fb = &cmdbuf->state.gfx.render.fb.info;
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+   uint32_t mask = 0;
+   for (unsigned i = 0; i < fb->rt_count; i++)
+      if (fb->rts[i].preload)
+         mask |= BITFIELD_BIT(i);
+   if (!mask && !fb->zs.preload.z && !fb->zs.preload.s)
+      return VK_SUCCESS;
+
+   /* Start with the fixed-function color formats. Other formats need Midgard
+    * blend/type-conversion shaders; Z/S and layered/MSAA jobs need distinct
+    * shader keys, texture views and renderer state. Never silently lose them.
+    */
+   if (fb->zs.preload.z || fb->zs.preload.s || fb->nr_samples != 1 ||
+       cmdbuf->state.gfx.render.layer_count != 1)
+      goto unsupported;
+   u_foreach_bit(rt, mask) {
+      const struct pan_image_view *view = fb->rts[rt].view;
+      if (!view || view->dim != MALI_TEXTURE_DIMENSION_2D ||
+          view->first_layer != view->last_layer ||
+          !panfrost_blendable_formats_v7[view->format].internal)
+         goto unsupported;
+   }
+
+   VkResult result = panvk_v5_cmd_alloc_tls_desc(cmdbuf, true);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct panvk_internal_shader *shader;
+   result = get_shader(dev, mask, &shader);
+   if (result != VK_SUCCESS)
+      return result;
+   /* cmd_close_batch allocated TLS before entering this helper. The small
+    * preload shaders must not introduce an unbacked spill stack afterwards.
+    */
+   if (shader->info.tls_size)
+      goto unsupported;
+
+   struct panfrost_ptr rsd = panvk_cmd_alloc_desc_aggregate(
+      cmdbuf, PAN_DESC(RENDERER_STATE), PAN_DESC_ARRAY(fb->rt_count, BLEND));
+   struct panfrost_ptr sampler = panvk_cmd_alloc_desc(cmdbuf, SAMPLER);
+   struct panfrost_ptr varying = panvk_cmd_alloc_desc(cmdbuf, ATTRIBUTE);
+   struct panfrost_ptr buffers = panvk_cmd_alloc_desc(cmdbuf, ATTRIBUTE_BUFFER);
+   struct panfrost_ptr viewport = panvk_cmd_alloc_desc(cmdbuf, VIEWPORT);
+   struct panfrost_ptr coords = panvk_cmd_alloc_dev_mem(cmdbuf, desc, 64, 64);
+   struct panfrost_ptr textures = panvk_cmd_alloc_dev_mem(
+      cmdbuf, desc, util_bitcount(mask) * sizeof(mali_ptr), sizeof(mali_ptr));
+   struct panfrost_ptr job = panvk_cmd_alloc_desc(cmdbuf, TILER_JOB);
+   if (!rsd.cpu || !sampler.cpu || !varying.cpu || !buffers.cpu ||
+       !viewport.cpu || !coords.cpu || !textures.cpu || !job.cpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   const float rect[] = {0, 0, 0, 1, fb->width, 0, 0, 1,
+                         0, fb->height, 0, 1, fb->width, fb->height, 0, 1};
+   memcpy(coords.cpu, rect, sizeof(rect));
+   pan_pack(varying.cpu, ATTRIBUTE, cfg) {
+      cfg.buffer_index = 0;
+      cfg.offset_enable = true;
+      cfg.format = GENX(panfrost_format_from_pipe_format)(PIPE_FORMAT_R32G32B32_FLOAT)->hw;
+   }
+   pan_pack(buffers.cpu, ATTRIBUTE_BUFFER, cfg) {
+      cfg.pointer = coords.gpu;
+      cfg.stride = 4 * sizeof(float);
+      cfg.size = sizeof(rect);
+   }
+   pan_pack(sampler.cpu, SAMPLER, cfg) {
+      cfg.seamless_cube_map = false;
+      cfg.normalized_coordinates = false;
+      cfg.minify_nearest = true;
+      cfg.magnify_nearest = true;
+   }
+   pan_pack(viewport.cpu, VIEWPORT, cfg) {
+      cfg.scissor_minimum_x = fb->extent.minx & ~31;
+      cfg.scissor_minimum_y = fb->extent.miny & ~31;
+      cfg.scissor_maximum_x = MIN2(ALIGN_POT(fb->extent.maxx + 1, 32), fb->width) - 1;
+      cfg.scissor_maximum_y = MIN2(ALIGN_POT(fb->extent.maxy + 1, 32), fb->height) - 1;
+   }
+   pan_pack(rsd.cpu, RENDERER_STATE, cfg) {
+      pan_shader_prepare_rsd(&shader->info,
+                            panvk_priv_mem_dev_addr(shader->code_mem), &cfg);
+      cfg.properties.work_register_count = MAX2(shader->info.work_reg_count, 4);
+      cfg.properties.force_early_z = true;
+      cfg.multisample_misc.sample_mask = 0xffff;
+      cfg.multisample_misc.depth_function = MALI_FUNC_ALWAYS;
+      cfg.stencil_mask_misc.alpha_test_compare_function = MALI_FUNC_ALWAYS;
+   }
+   struct mali_blend_packed *blends = rsd.cpu + pan_size(RENDERER_STATE);
+   for (unsigned i = 0; i < fb->rt_count; i++) {
+      pan_pack(&blends[i], BLEND, cfg) {
+         cfg.enable = mask & BITFIELD_BIT(i);
+         cfg.round_to_fb_precision = true;
+         cfg.srgb = cfg.enable && util_format_is_srgb(fb->rts[i].view->format);
+         cfg.equation.rgb.a = MALI_BLEND_OPERAND_A_SRC;
+         cfg.equation.rgb.b = MALI_BLEND_OPERAND_B_SRC;
+         cfg.equation.rgb.c = MALI_BLEND_OPERAND_C_ZERO;
+         cfg.equation.alpha = cfg.equation.rgb;
+         cfg.equation.color_mask = 0xf;
+      }
+   }
+
+   unsigned idx = 0;
+   u_foreach_bit(rt, mask) {
+      const struct pan_image_view *view = fb->rts[rt].view;
+      size_t size = pan_size(TEXTURE) +
+                    GENX(panfrost_estimate_texture_payload_size)(view);
+      struct panfrost_ptr tex = panvk_cmd_alloc_dev_mem(
+         cmdbuf, desc, size, pan_alignment(TEXTURE));
+      if (!tex.cpu)
+         return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      struct panfrost_ptr surfaces = {.cpu = tex.cpu + pan_size(TEXTURE),
+                                     .gpu = tex.gpu + pan_size(TEXTURE)};
+      GENX(panfrost_new_texture)(view, tex.cpu, &surfaces);
+      ((mali_ptr *)textures.cpu)[idx++] = tex.gpu;
+   }
+
+   pan_section_pack(job.cpu, TILER_JOB, DRAW, cfg) {
+      cfg.thread_storage = batch->tls.gpu;
+      cfg.state = rsd.gpu;
+      cfg.position = coords.gpu;
+      cfg.viewport = viewport.gpu;
+      cfg.varyings = varying.gpu;
+      cfg.varying_buffers = buffers.gpu;
+      cfg.textures = textures.gpu;
+      cfg.samplers = sampler.gpu;
+   }
+   pan_section_pack(job.cpu, TILER_JOB, PRIMITIVE, cfg) {
+      cfg.draw_mode = MALI_DRAW_MODE_TRIANGLE_STRIP;
+      cfg.index_count = 4;
+      cfg.job_task_split = 6;
+   }
+   pan_section_pack(job.cpu, TILER_JOB, PRIMITIVE_SIZE, cfg) {
+      cfg.constant = 1.0f;
+   }
+   panfrost_pack_work_groups_compute(
+      pan_section_ptr(job.cpu, TILER_JOB, INVOCATION), 1, 4, 1, 1, 1, 1, true, false);
+   util_dynarray_append(&batch->jobs, void *, job.cpu);
+   pan_jc_add_job(&batch->vtc_jc, MALI_JOB_TYPE_TILER, false, false,
+                  0, 0, &job, true);
+   return VK_SUCCESS;
+
+unsupported:
+   vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_FEATURE_NOT_PRESENT);
+   return VK_ERROR_FEATURE_NOT_PRESENT;
+}
