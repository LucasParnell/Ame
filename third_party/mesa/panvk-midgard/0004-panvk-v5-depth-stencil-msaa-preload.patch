+
+VkResult
+panvk_v5_cmd_fb_preload(struct panvk_cmd_buffer *cmdbuf)
+{
+   const struct pan_fb_info *fb = &cmdbuf->state.gfx.render.fb.info;
+   uint32_t mask = 0;
+   for (unsigned rt = 0; rt < fb->rt_count; rt++)
+      if (fb->rts[rt].preload) mask |= BITFIELD_BIT(rt);
+   bool zs = fb->zs.preload.z || fb->zs.preload.s;
+   if (!mask && !zs) return VK_SUCCESS;
+   if (cmdbuf->state.gfx.render.layer_count != 1) return VK_ERROR_FEATURE_NOT_PRESENT;
+   u_foreach_bit(rt, mask) {
+      if (!panfrost_blendable_formats_v7[fb->rts[rt].view->format].internal)
+         return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+   VkResult result = panvk_v5_cmd_alloc_tls_desc(cmdbuf, true);
+   if (result != VK_SUCCESS) return result;
+   /* Injection prepends jobs. Insert color first so depth/stencil executes
+    * before color and both execute before the application tiler chain. */
+   if (mask) {
+      result = emit_preload(cmdbuf, mask, false);
+      if (result != VK_SUCCESS) return result;
+   }
+   return zs ? emit_preload(cmdbuf, 0, true) : VK_SUCCESS;
+}
