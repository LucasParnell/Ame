+static bool
+inline_constants(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_blend_const_color_rgba)
+      return false;
+   const float *constants = data;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def_rewrite_uses(&intr->def, nir_imm_vec4(b, constants[0], constants[1], constants[2], constants[3]));
+   return true;
+}
