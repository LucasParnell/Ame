+VkResult
+panvk_v5_get_blend_shader(struct panvk_device *dev,
+                         const struct pan_blend_state *state, nir_alu_type src0_type,
+                         nir_alu_type src1_type, unsigned rt,
+                         mali_ptr *address, unsigned *work_regs)
+{
+   struct blend_key key = {
+      .type = PANVK_META_OBJECT_KEY_BLEND_SHADER,
+      .format = state->rts[rt].format,
+      .rt = rt,
+      .src0_type = src0_type,
+      .src1_type = src1_type,
+      .nr_samples = state->rts[rt].nr_samples,
+      .logicop_enable = state->logicop_enable,
+      .alpha_to_one = state->alpha_to_one,
+      .logicop_func = state->logicop_func,
+      .equation = state->rts[rt].equation,
+   };
+   memcpy(key.constants, state->constants, sizeof(key.constants));
+   VkShaderEXT handle = (VkShaderEXT)vk_meta_lookup_object(
+      &dev->meta, VK_OBJECT_TYPE_SHADER_EXT, &key, sizeof(key));
+   struct panvk_internal_shader *shader;
+   if (handle != VK_NULL_HANDLE) goto out;
+   nir_shader *nir = GENX(pan_blend_create_shader)(state, src0_type, src1_type, rt);
+   NIR_PASS_V(nir, nir_shader_intrinsics_pass, inline_constants,
+              nir_metadata_control_flow, (void *)state->constants);
+   struct panvk_physical_device *pdev = to_panvk_physical_device(dev->vk.physical);
+   struct panfrost_compile_inputs inputs = {
+      .gpu_id = pdev->kmod.props.gpu_prod_id,
+      .is_blend = true,
+      .no_ubo_to_push = true,
+      .blend.nr_samples = key.nr_samples,
+   };
+   pan_shader_preprocess(nir, inputs.gpu_id);
+   enum pipe_format formats[8] = {0};
+   formats[rt] = key.format;
+   NIR_PASS_V(nir, pan_lower_framebuffer, formats,
+              pan_raw_format_mask_midgard(formats), MAX2(key.nr_samples, 1),
+              inputs.gpu_id < 0x700);
+   VkResult result = panvk_v5_create_internal_shader(dev, nir, &inputs, &shader);
+   ralloc_free(nir);
+   if (result != VK_SUCCESS) return result;
+   handle = (VkShaderEXT)vk_meta_cache_object(&dev->vk, &dev->meta, &key, sizeof(key),
+      VK_OBJECT_TYPE_SHADER_EXT, (uint64_t)panvk_internal_shader_to_handle(shader));
+out:
+   shader = panvk_internal_shader_from_handle(handle);
+   *address = panvk_priv_mem_dev_addr(shader->code_mem) | shader->info.midgard.first_tag;
+   *work_regs = MAX2(shader->info.work_reg_count, 8);
+   return VK_SUCCESS;
