 #include "drm-uapi/panfrost_drm.h"
 
+/* Called after a synchronized submission. Decode only failed chains when
+ * requested, keeping successful diagnostic cases within the console budget. */
+static bool
+panvk_batch_has_fault(struct panvk_batch *batch)
+{
+   util_dynarray_foreach(&batch->jobs, void *, job) {
+      if (((volatile uint32_t *)*job)[0] > 1)
+         return true;
+   }
+   return false;
+}
+
 static VkResult
 panvk_queue_submit_batch(struct panvk_queue *queue, struct panvk_batch *batch,
                          uint32_t *bos, unsigned nr_bos, uint32_t *in_fences,
@@ -81,14 +93,15 @@
       if (ret)
          return vk_queue_set_lost(&queue->vk, "DRM submission/synchronization failed: %m");
 
-      if (debug & (PANVK_DEBUG_TRACE | PANVK_DEBUG_SYNC)) {
+      if (debug & (PANVK_DEBUG_TRACE | PANVK_DEBUG_SYNC | PANVK_DEBUG_TRACE_FAULT)) {
          ret = drmSyncobjWait(dev->vk.drm_fd, &submit.out_sync, 1, INT64_MAX, 0,
                               NULL);
          if (ret)
             return vk_queue_set_lost(&queue->vk, "DRM submission/synchronization failed: %m");
       }
 
-      if (debug & PANVK_DEBUG_TRACE) {
+      if ((debug & PANVK_DEBUG_TRACE) ||
+          ((debug & PANVK_DEBUG_TRACE_FAULT) && panvk_batch_has_fault(batch))) {
          pandecode_jc(dev->debug.decode_ctx, batch->vtc_jc.first_job,
                       phys_dev->kmod.props.gpu_prod_id);
       }
