diff --git a/src/panfrost/vulkan/midgard/panvk_v5_dispatch.h b/src/panfrost/vulkan/midgard/panvk_v5_dispatch.h
--- /dev/null
+++ b/src/panfrost/vulkan/midgard/panvk_v5_dispatch.h
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: MIT */
+/* GPU patching follows pan_indirect_dispatch.c's invocation encoding. */
+#include "nir_builder.h"
+#include "pan_shader.h"
+#include "panvk_shader.h"
+
+struct panvk_dispatch_patch_inputs {
+   uint64_t job, dimensions, num_workgroups;
+   uint32_t invocation[2];
+};
+
+static nir_def *
+dispatch_patch_input(nir_builder *b, unsigned offset)
+{
+   return nir_load_ubo(b, 1, 64, nir_imm_int(b, 0), nir_imm_int(b, offset),
+                      .align_mul = 8, .range = sizeof(struct panvk_dispatch_patch_inputs));
+}
+
+static VkResult
+panvk_get_dispatch_patch_shader(struct panvk_device *dev, struct panvk_internal_shader **out)
+{
+   const uint32_t key = PANVK_META_OBJECT_KEY_DISPATCH_PATCH_SHADER;
+   VkShaderEXT handle = (VkShaderEXT)vk_meta_lookup_object(
+      &dev->meta, VK_OBJECT_TYPE_SHADER_EXT, &key, sizeof(key));
+   if (handle) {
+      *out = panvk_internal_shader_from_handle(handle);
+      return VK_SUCCESS;
+   }
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_COMPUTE,
+      GENX(pan_shader_get_compiler_options)(), "panvk-midgard-dispatch-patch");
+   b.shader->info.workgroup_size[0] = b.shader->info.workgroup_size[1] = b.shader->info.workgroup_size[2] = 1;
+   b.shader->info.num_ubos = 1;
+#define PATCH_INPUT(field) dispatch_patch_input(&b, offsetof(struct panvk_dispatch_patch_inputs, field))
+   nir_def *counts = nir_load_global(&b, PATCH_INPUT(dimensions), 4, 3, 32);
+   nir_def *x = nir_channel(&b, counts, 0), *y = nir_channel(&b, counts, 1), *z = nir_channel(&b, counts, 2);
+   nir_store_global(&b, PATCH_INPUT(num_workgroups), 4, counts, 7);
+   nir_def *empty = nir_ior(&b, nir_ieq_imm(&b, x, 0),
+      nir_ior(&b, nir_ieq_imm(&b, y, 0), nir_ieq_imm(&b, z, 0)));
+   nir_def *job = PATCH_INPUT(job);
+   nir_push_if(&b, empty);
+   nir_store_global(&b, nir_iadd_imm(&b, job, 16), 1,
+      nir_imm_intN_t(&b, (MALI_JOB_TYPE_NULL << 1) | 1, 8), 1);
+   nir_push_else(&b, NULL);
+   /* A previous execution may have made this a NULL job. */
+   nir_store_global(&b, nir_iadd_imm(&b, job, 16), 1,
+      nir_imm_intN_t(&b, (MALI_JOB_TYPE_COMPUTE << 1) | 1, 8), 1);
+   nir_def *invocation = nir_iadd_imm(&b, job, pan_section_offset(COMPUTE_JOB, INVOCATION));
+   /* Rebuild from the recorded template, not last submission's patched bits. */
+   nir_def *original = nir_unpack_64_2x32(&b, PATCH_INPUT(invocation));
+   nir_def *dimensions = nir_channel(&b, original, 0);
+   nir_def *split = nir_channel(&b, original, 1);
+   nir_def *x_shift = nir_iand_imm(&b, nir_ushr_imm(&b, split, 10), 0x3f);
+   nir_def *y_shift = nir_iadd(&b, x_shift, nir_isub(&b, nir_imm_int(&b, 32), nir_uclz(&b, nir_iadd_imm(&b, x, -1))));
+   nir_def *z_shift = nir_iadd(&b, y_shift, nir_isub(&b, nir_imm_int(&b, 32), nir_uclz(&b, nir_iadd_imm(&b, y, -1))));
+   split = nir_ior(&b, split, nir_ior(&b, nir_ishl_imm(&b, y_shift, 16), nir_ishl_imm(&b, z_shift, 22)));
+   dimensions = nir_ior(&b, dimensions, nir_ior(&b, nir_ishl(&b, nir_iadd_imm(&b, x, -1), x_shift),
+      nir_ior(&b, nir_ishl(&b, nir_iadd_imm(&b, y, -1), y_shift), nir_ishl(&b, nir_iadd_imm(&b, z, -1), z_shift))));
+   nir_store_global(&b, invocation, 8, nir_vec2(&b, dimensions, split), 3);
+   nir_pop_if(&b, NULL);
+#undef PATCH_INPUT
+   nir_shader_gather_info(b.shader, nir_shader_get_entrypoint(b.shader));
+   struct panvk_physical_device *pdev = to_panvk_physical_device(dev->vk.physical);
+   struct panfrost_compile_inputs inputs = {.gpu_id = pdev->kmod.props.gpu_prod_id, .no_ubo_to_push = true};
+   pan_shader_preprocess(b.shader, inputs.gpu_id);
+   struct panvk_internal_shader *shader;
+   VkResult result = panvk_v5_create_internal_shader(dev, b.shader, &inputs, &shader);
+   ralloc_free(b.shader);
+   if (result != VK_SUCCESS) return result;
+   handle = (VkShaderEXT)vk_meta_cache_object(&dev->vk, &dev->meta, &key, sizeof(key),
+      VK_OBJECT_TYPE_SHADER_EXT, (uint64_t)panvk_internal_shader_to_handle(shader));
+   *out = panvk_internal_shader_from_handle(handle);
+   return VK_SUCCESS;
+}
+
+static VkResult
+panvk_emit_dispatch_patch(struct panvk_cmd_buffer *cmd, mali_ptr dimensions,
+                         struct panfrost_ptr target, mali_ptr sysvals, unsigned *dependency)
+{
+   struct panvk_device *dev = to_panvk_device(cmd->vk.base.device);
+   struct panvk_internal_shader *shader;
+   VkResult result = panvk_get_dispatch_patch_shader(dev, &shader);
+   if (result != VK_SUCCESS) return result;
+   struct panfrost_ptr data = panvk_cmd_alloc_dev_mem(cmd, desc, sizeof(struct panvk_dispatch_patch_inputs), 16);
+   struct panfrost_ptr ubo = panvk_cmd_alloc_desc(cmd, UNIFORM_BUFFER);
+   struct panfrost_ptr rsd = panvk_cmd_alloc_desc(cmd, RENDERER_STATE);
+   struct panfrost_ptr job = panvk_cmd_alloc_desc(cmd, COMPUTE_JOB);
+   if (!data.cpu || !ubo.cpu || !rsd.cpu || !job.cpu) return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   struct panvk_dispatch_patch_inputs *inputs = data.cpu;
+   *inputs = (struct panvk_dispatch_patch_inputs){.job = target.gpu, .dimensions = dimensions, .num_workgroups = sysvals};
+   memcpy(inputs->invocation, pan_section_ptr(target.cpu, COMPUTE_JOB, INVOCATION), sizeof(inputs->invocation));
+   pan_pack(ubo.cpu, UNIFORM_BUFFER, cfg) {cfg.pointer = data.gpu; cfg.entries = DIV_ROUND_UP(sizeof(struct panvk_dispatch_patch_inputs), 16);}
+   pan_pack(rsd.cpu, RENDERER_STATE, cfg) {pan_shader_prepare_rsd(&shader->info, panvk_priv_mem_dev_addr(shader->code_mem), &cfg);}
+   panfrost_pack_work_groups_compute(pan_section_ptr(job.cpu, COMPUTE_JOB, INVOCATION), 1, 1, 1, 1, 1, 1, false, false);
+   pan_section_pack(job.cpu, COMPUTE_JOB, PARAMETERS, cfg) {cfg.job_task_split = 2;}
+   pan_section_pack(job.cpu, COMPUTE_JOB, DRAW, cfg) {
+      cfg.state = rsd.gpu;
+      cfg.uniform_buffers = ubo.gpu;
+      cfg.thread_storage = cmd->cur_batch->tls.gpu;
+   }
+   util_dynarray_append(&cmd->cur_batch->jobs, void *, job.cpu);
+   /* Suppress descriptor prefetch across the self-modifying job boundary. */
+   *dependency = pan_jc_add_job(&cmd->cur_batch->vtc_jc, MALI_JOB_TYPE_COMPUTE,
+      true, true, 0, 0, &job, false);
+   cmd->cur_batch->tlsinfo.tls.size = MAX2(cmd->cur_batch->tlsinfo.tls.size, shader->info.tls_size);
+   return VK_SUCCESS;
+}
