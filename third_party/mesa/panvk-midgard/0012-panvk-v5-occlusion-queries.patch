@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef PANVK_QUERY_POOL_H
+#define PANVK_QUERY_POOL_H
+#include "vk_query_pool.h"
+#include "panvk_priv_bo.h"
+struct panvk_query_pool {
+   struct vk_query_pool vk;
+   struct panvk_priv_bo *storage;
+   uint32_t stride, core_count;
+};
+VK_DEFINE_NONDISP_HANDLE_CASTS(panvk_query_pool, vk.base, VkQueryPool, VK_OBJECT_TYPE_QUERY_POOL)
