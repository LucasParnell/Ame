+
+/* JM submission must pin shader, descriptor, storage, query and vertex/index
+ * BOs as well as framebuffer attachments. Keep a conservative device snapshot
+ * until submit has transferred references to the kernel. */
+void
+panvk_device_add_resident_bo(struct panvk_device *dev,
+   struct panvk_resident_bo *entry, struct pan_kmod_bo *bo)
+{
+   simple_mtx_lock(&dev->as.lock);
+   entry->bo = bo;
+   list_addtail(&entry->node, &dev->resident_bos);
+   dev->resident_bo_count++;
+   simple_mtx_unlock(&dev->as.lock);
+}
+void
+panvk_device_remove_resident_bo(struct panvk_device *dev,
+   struct panvk_resident_bo *entry)
+{
+   simple_mtx_lock(&dev->as.lock);
+   if (entry->bo) {
+      list_del(&entry->node);
+      entry->bo = NULL;
+      dev->resident_bo_count--;
+   }
+   simple_mtx_unlock(&dev->as.lock);
+}
+VkResult
+panvk_device_snapshot_bos(struct panvk_device *dev,
+   struct panvk_bo_snapshot *snapshot)
+{
+   *snapshot = (struct panvk_bo_snapshot){0};
+   for (;;) {
+      simple_mtx_lock(&dev->as.lock);
+      uint32_t count = dev->resident_bo_count;
+      simple_mtx_unlock(&dev->as.lock);
+      if (count > UINT32_MAX - 64)
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+      uint32_t capacity = count + 64;
+      struct pan_kmod_bo **bos = vk_alloc(&dev->vk.alloc,
+         (size_t)capacity * sizeof(*bos), 8, VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+      if (!bos)
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+      simple_mtx_lock(&dev->as.lock);
+      if (dev->resident_bo_count > capacity) {
+         simple_mtx_unlock(&dev->as.lock);
+         vk_free(&dev->vk.alloc, bos);
+         continue;
+      }
+      uint32_t index = 0;
+      list_for_each_entry(struct panvk_resident_bo, entry,
+                          &dev->resident_bos, node)
+         bos[index++] = pan_kmod_bo_get(entry->bo);
+      simple_mtx_unlock(&dev->as.lock);
+      snapshot->bos = bos;
+      snapshot->count = index;
+      return VK_SUCCESS;
+   }
+}
+void
+panvk_device_finish_bo_snapshot(struct panvk_device *dev,
+   struct panvk_bo_snapshot *snapshot)
+{
+   for (uint32_t i = 0; i < snapshot->count; i++)
+      pan_kmod_bo_put(snapshot->bos[i]);
+   vk_free(&dev->vk.alloc, snapshot->bos);
+   *snapshot = (struct panvk_bo_snapshot){0};
+}
