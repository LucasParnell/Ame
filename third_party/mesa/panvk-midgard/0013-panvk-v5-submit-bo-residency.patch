+   /* V5 currently exposes one queue and no external-memory/sync extensions.
+    * Conservatively pin all live BOs until per-batch resource tracking is
+    * available; narrower tracking is needed before relaxing those limits. */
+   VkResult result = panvk_device_snapshot_bos(dev, &resident);
+   if (result != VK_SUCCESS)
