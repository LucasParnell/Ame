+#if PAN_ARCH == 5
+static VkResult
+panvk_v5_select_layer(struct panvk_cmd_buffer *cmd, uint32_t layer)
+{
+   panvk_v5_cmd_close_batch(cmd);
+   struct panvk_rendering_state *render = &cmd->state.gfx.render;
+   struct pan_fb_info *fb = &render->fb.info;
+   render->logical_layer_index = layer;
+   for (unsigned i = 0; i < MAX_RTS + 2; i++) {
+      const struct pan_image_view *base = render->layer_bases[i];
+      if (!base)
+         continue;
+      if (layer > base->last_layer - base->first_layer)
+         return VK_ERROR_INITIALIZATION_FAILED;
+      render->layer_views[i] = *base;
+      render->layer_views[i].first_layer += layer;
+      render->layer_views[i].last_layer = render->layer_views[i].first_layer;
+      if (i < MAX_RTS) {
+         fb->rts[i].view = &render->layer_views[i];
+         /* CRC validity is per image slice. Disable reuse across slices rather
+          * than sharing one attachment-valid bit between independent layers. */
+         render->fb.crc_valid[i] = false;
+      } else if (i == MAX_RTS) {
+         fb->zs.view.zs = &render->layer_views[i];
+      } else {
+         fb->zs.view.s = &render->layer_views[i];
+      }
+   }
+   return panvk_v5_cmd_open_batch(cmd) ? VK_SUCCESS : VK_ERROR_OUT_OF_DEVICE_MEMORY;
+}
